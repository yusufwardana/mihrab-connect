<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#05261B"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="COSMICLABS • Mihrab Kiosk"
            android:textColor="#D4AF37"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/settings_subtitle"
            android:textColor="#9DB8A8"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/label_url"
            android:textColor="#F5EFE0"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#0A3D2D"
            android:hint="@string/hint_url"
            android:inputType="textUri"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7FA08D"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/help_url"
            android:textColor="#9DB8A8"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_refresh"
            android:textColor="#F5EFE0"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_refresh"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#0A3D2D"
            android:hint="@string/hint_refresh"
            android:inputType="number"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7FA08D"
            android:textSize="16sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/help_refresh"
            android:textColor="#9DB8A8"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/label_pin"
            android:textColor="#F5EFE0"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_pin_lama"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:background="#0A3D2D"
            android:hint="@string/hint_pin_lama"
            android:inputType="numberPassword"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7FA08D"
            android:textSize="16sp" />

        <EditText
            android:id="@+id/et_pin_baru"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="#0A3D2D"
            android:hint="@string/hint_pin_baru"
            android:inputType="numberPassword"
            android:padding="12dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#7FA08D"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_simpan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="#D4AF37"
            android:text="@string/simpan"
            android:textColor="#05261B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_muat_ulang"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0A3D2D"
            android:text="@string/muat_ulang_board"
            android:textColor="#F5EFE0"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_reboot"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#7A1F1F"
            android:text="@string/reboot_perangkat"
            android:textColor="#FFFFFF"
            android:textSize="16sp" />

        <Button
            android:id="@+id/btn_kembali"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="#0A3D2D"
            android:text="@string/kembali"
            android:textColor="#F5EFE0"
            android:textSize="16sp" />

    </LinearLayout>
</ScrollView>
